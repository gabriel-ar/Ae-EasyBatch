{
  "svelteSortOrder": "none",
  "svelteAllowShorthand": true,
  "svelteIndentScriptAndStyle": true,
  "bracketSameLine": true,
  "objectWrap": "collapse",
  "bracketSpacing": false,
  "plugins": ["prettier-plugin-svelte"],
  "overrides": [
    {
      "files": "*.svelte",
      "options": {
        "parser": "svelte"
      }
    }
  ]
}
